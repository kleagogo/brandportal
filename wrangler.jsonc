{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pitho",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-09-01",
  // nodejs_compat: the app uses node:crypto and friends.
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  // Public, non-secret config. It lives here rather than in the dashboard
  // because `wrangler deploy` replaces the Worker's plain-text variables with
  // whatever this file declares — a dashboard-only value silently disappears
  // on the next push, which is how sign-in email broke on 2026-08-18.
  // Secrets are stored separately by Cloudflare and survive a deploy.
  "vars": {
    // A person, not a department. Replies land in the founder's inbox via
    // Cloudflare Email Routing; hello@ still forwards there too.
    "EMAIL_FROM": "Hermione from Pitho <hermione@pitho.io>",
    // 500MB is what Cloudflare accepts as a request body on the Paid plan.
    // Deliverable brand film sits under it; a ProRes master never will, and
    // belongs somewhere built for masters rather than in a brand hub.
    "UPLOAD_MAX_MB": "500",
    // Who sees the admin controls (free-plan grants). Emails aren't secrets,
    // and living here means a deploy can't wipe it.
    "ADMIN_EMAILS": "hermionegogou@gmail.com,hermione@pitho.io",
    // Polar product ids — public identifiers, not secrets. The access token
    // and webhook secret are real secrets and live in Cloudflare Secrets.
    "POLAR_PRODUCT_FOUNDING": "8aaf30ad-32f2-4e2e-a6b9-5d4758a17488",
    "POLAR_PRODUCT_STUDIO": "c20e3bda-cb7b-40b2-a71e-cdab43db3732"
  },
  // Uploaded assets. Binding the bucket means no S3 API token to issue,
  // store, or rotate — see lib/r2.ts for what the binding can and can't do.
  "r2_buckets": [
    {
      "binding": "ASSETS_BUCKET",
      "bucket_name": "pitho-assets"
    }
  ]
  // Secrets (DATABASE_URL, AUTH_SECRET, R2_*, RESEND_API_KEY, ANTHROPIC_API_KEY)
  // are set in the Cloudflare dashboard, not here — they don't belong in git.
}

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pitho",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-09-01",
  // nodejs_compat: the app uses node:crypto and friends.
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  // Uploaded assets. Binding the bucket means no S3 API token to issue,
  // store, or rotate — see lib/r2.ts for what the binding can and can't do.
  "r2_buckets": [
    {
      "binding": "ASSETS_BUCKET",
      "bucket_name": "pitho-assets"
    }
  ]
  // Secrets (DATABASE_URL, AUTH_SECRET, R2_*, RESEND_API_KEY, ANTHROPIC_API_KEY)
  // are set in the Cloudflare dashboard, not here — they don't belong in git.
}
